# Number of sensors-server instances (any positive number). Gateway discovers them via compose DNS.
INSTANCES=1

NATS_URL=nats://nats:4222

# --- warehouse-service ---
# Comma-separated ids of registered sensors; datagrams from other ids are ignored
SENSOR_IDS=t1,h1
# UDP ports. If changed, also update nginx/nginx.conf and the gateway/expose ports in docker-compose.yml
HUMIDITY_PORT=3344
TEMPERATURE_PORT=3355
SHUTDOWN_TIMEOUT_SEC=5
# Capacity of the queue of measurements waiting to be published to NATS
PUBLISH_QUEUE_CAPACITY=10000

# --- central-monitoring-service ---
NATS_SUBJECT=sensors.>
HTTP_PORT=8080
# Alert limits: ALERT is logged when a value exceeds them
TEMPERATURE_LIMIT=35
HUMIDITY_LIMIT=50
